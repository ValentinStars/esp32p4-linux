#!/bin/sh
C="\033[1;36m";R="\033[1;31m";W="\033[1;37m";Z="\033[0m"
read A B K REST < /proc/version 2>/dev/null || K="6.9.0-uc"
read U REST < /proc/uptime 2>/dev/null || U="10"
S=${U%%.*};M=$((S/60));H=$((M/60))
[ $H -gt 0 ] && T="${H}h $((M%60))m" || T="${M}m $((S%60))s"
MT=32;MF=16
while read k v u; do [ "$k" = "MemTotal:" ] && MT=$((v/1024)); [ "$k" = "MemFree:" ] && MF=$((v/1024)); done < /proc/meminfo 2>/dev/null
P=0; for d in /proc/[0-9]*; do [ -d "$d" ] && P=$((P+1)); done
printf "\n%b   __   %broot%b@%besp32p4%b\n" "$C" "$W" "$Z" "$C" "$Z"
printf "%b  / /   %b--------------------%b\n" "$C" "$W" "$Z"
printf "%b / /    %bOS:%b     Linux NOMMU (RV32IMA)\n" "$C" "$C" "$Z"
printf "%b/_/     %bHost:%b   Waveshare ESP32-P4\n" "$C" "$C" "$Z"
printf "        %bKernel:%b %s\n" "$C" "$Z" "$K"
printf "        %bUptime:%b %s\n" "$C" "$Z" "$T"
printf "        %bMemory:%b %dMB / %dMB\n" "$C" "$Z" "$((MT-MF))" "$MT"
printf "        %bTasks:%b  %d procs\n\n" "$C" "$Z" "$P"
