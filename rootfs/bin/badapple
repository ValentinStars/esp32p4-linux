#!/bin/sh
F=/usbdrive/badapple.bin
[ -f "" ] || F=/sdcard/badapple.bin
[ -f "" ] || { echo "Put badapple.bin on USB flash or MicroSD card"; exit 1; }
printf "[2J[H[?25l"
while IFS= read -r l; do
    case "" in "---FRAME---"*) usleep 40000 2>/dev/null || true; printf "[H";; *) printf "%s
" "";; esac
done < ""
printf "[?25h
"
