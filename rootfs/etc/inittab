# /etc/inittab - Конфигурация BusyBox Init для ESP32-P4 RISC-V Linux

# 1. Запуск сценариев инициализации системы
::sysinit:/etc/init.d/rcS

# 2. Интерактивная консоль на последовательном порту UART (ttyS0)
# getty запускает полноценную сессию с авторизацией и терминалом vt100 / xterm
ttyS0::respawn:/sbin/getty -L 115200 ttyS0 vt100
console::respawn:/sbin/getty -L 115200 console vt100

# 3. Перехват комбинации Ctrl+Alt+Del (программная перезагрузка)
::ctrlaltdel:/sbin/reboot

# 4. Процедура корректного завершения работы (Shutdown)
::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
::shutdown:/sbin/swapoff -a
