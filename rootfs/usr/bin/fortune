#!/bin/sh
# fortune - Случайная цитата Unix/Linux для ESP32-P4
FORTUNES="
\"Linux is only free if your time has no value.\" - Jamie Zawinski
\"Talk is cheap. Show me the code.\" - Linus Torvalds
\"There are 10 types of people in the world: those who understand binary, and those who do not.\"
\"Simplicity is prerequisite for reliability.\" - Edsger W. Dijkstra
\"RISC-V: Instruction sets want to be free!\" - David Patterson
\"ESP32-P4: Dual-core 400MHz RISC-V powerhouse running Linux!\"
\"UNIX is basically a simple operating system, but you have to be a genius to understand the simplicity.\" - Dennis Ritchie
\"Software is like sex: it's better when it's free.\" - Linus Torvalds
\"First, solve the problem. Then, write the code.\" - John Johnson
"

NUM_LINES=9
RAND_IDX=$(( ( $(date +%s 2>/dev/null || echo 42) % NUM_LINES ) + 1 ))

echo "$FORTUNES" | sed '/^$/d' | sed -n "${RAND_IDX}p"
